HTTP_PORT=8080
CHATBOT_API_KEY=troque-por-uma-chave-longa-e-aleatoria
MK_BASE_URL=http://177.72.80.20:8080

# Porta publicada pelo Docker apenas no endereço local, para uso por proxy HTTPS.
API_BIND_ADDRESS=127.0.0.1
API_PUBLIC_PORT=8080

# Este MK não oferece HTTPS. O tráfego deve ser protegido pela infraestrutura/rede.
MK_ALLOW_INSECURE_HTTP=true

# Token fixo do cadastro do usuário autorizado a consumir o Webservice.
MK_USER_ACCESS_TOKEN=
# Contrassenha gerada na criação do perfil de Webservice.
MK_WEBSERVICE_COUNTER_PASSWORD=

# Tempo durante o qual a API reutiliza o token temporário retornado por WSAutenticacao.
MK_TEMPORARY_AUTH_TOKEN_TTL=5m

# Alternativa para diagnóstico: token temporário já retornado pelo MK.
# Se preenchido, a autenticação automática acima não será usada.
# MK_TEMPORARY_AUTH_TOKEN=

MK_HTTP_TIMEOUT=10s
